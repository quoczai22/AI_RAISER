GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_CHAT_TURNS=5
GEMINI_TIMEOUT_MS=45000
MAX_MESSAGE_LENGTH=1000
MAX_JSON_BODY_BYTES=65536
MAX_SESSIONS=200
PORT=3000
# Server-side Firestore configuration (Node.js Admin/IAM identity; default deny client access)
FIRESTORE_PROJECT_ID=
# Leave empty for the default database. Set only for a named Firestore database.
FIRESTORE_DATABASE_ID=
ENABLE_FIRESTORE=false
